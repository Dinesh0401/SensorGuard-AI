# SensorGuard AI — environment configuration
# Copy this file to .env and fill in secrets before running locally or with Docker.
# NEVER commit .env or paste secrets into issues, prompts, or logs.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the FastAPI backend and alembic migrations.
DATABASE_URL=postgresql+psycopg2://sensorguard:sensorguard@localhost:5432/sensorguard

# Docker Compose only: password for the sensorguard DB user
POSTGRES_PASSWORD=sensorguard

# ─── API security ─────────────────────────────────────────────────────────────
# Secret key required for admin/ingest endpoints (/api/v1/ingest, /api/v1/admin/*).
# Use a strong random value in production (e.g. openssl rand -hex 32).
ADMIN_API_KEY=change-me-in-production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests to the FastAPI backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Live data ingestion (optional) ──────────────────────────────────────────
# Set ENABLE_LIVE_PROVIDER_FETCH=true only when you have a valid OPENAQ_API_KEY.
# When false (default) the system uses only the data already in the database.
ENABLE_LIVE_PROVIDER_FETCH=false
ENABLE_INGEST_SCHEDULER=false

# OpenAQ v3 API key — only needed with live fetch enabled.
# Register at https://api.openaq.org to obtain a key (free tier available).
OPENAQ_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Public base URL of the FastAPI backend, as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
