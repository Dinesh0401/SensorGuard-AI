# SensorGuard AI — environment configuration
# Copy this file to .env and fill in strong secrets before running Docker Compose or PostgreSQL.
# NEVER commit .env or paste secrets into issues, prompts, or logs.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL password (required by docker-compose.yml; generate via: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Full SQLAlchemy URL (omit/leave unset for local SQLite staging data/sensorguard.db;
# for PostgreSQL production, include ?sslmode=require and a strong password):
# DATABASE_URL=postgresql+psycopg2://sensorguard_app:<STRONG_PASSWORD>@db.internal:5432/sensorguard?sslmode=require

# ─── API security ─────────────────────────────────────────────────────────────
# Secret key required for admin endpoints (/api/v1/admin/ingest, /api/v1/admin/evaluate).
# API fails closed (HTTP 503) if unset. Generate via: openssl rand -hex 32
ADMIN_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests to the FastAPI backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Live data ingestion (optional) ──────────────────────────────────────────
# Set ENABLE_LIVE_PROVIDER_FETCH=true only when you have a valid OPENAQ_API_KEY.
# When false (default), only historical/archived observations in DB are served.
ENABLE_LIVE_PROVIDER_FETCH=false
ENABLE_INGEST_SCHEDULER=false

# OpenAQ v3 API key — only needed with live fetch enabled.
# Register at https://api.openaq.org to obtain a key (free tier available).
OPENAQ_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Public base URL of the FastAPI backend as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
